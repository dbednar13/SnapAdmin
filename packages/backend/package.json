{
  "name": "backend",
  "version": "1.0.1",
  "description": "SnapAdmin Express Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json && node scripts/prepare-config.cjs",
    "test": "tsx --test test/configFileHelper.test.ts",
    "test:typecheck": "pnpm --filter common build && tsc --noEmit -p test/tsconfig.json",
    "start": "node dist/index.js",
    "prettier:check": "prettier --check .",
    "eslint:check": "eslint .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "keywords": [
    "express",
    "typescript"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "circle-buffer": "^0.2.2",
    "common": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-status-codes": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
