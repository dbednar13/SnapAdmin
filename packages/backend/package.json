{
  "name": "backend",
  "version": "0.2.5",
  "description": "SnapAdmin Express Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); const path=require('path'); const src=path.resolve('config.yaml'); const dest=path.resolve('dist/config.yaml'); fs.copyFileSync(src, dest);\"",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "keywords": [
    "express",
    "typescript"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "circle-buffer": "^0.2.2",
    "common": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "http-status-codes": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
