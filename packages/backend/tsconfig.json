{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "paths": {
      "@constants": ["./src/constants"],
      "@types": ["./src/types"],
      "@utils": ["./src/utilities"]
    }
  },
  "references": [{ "path": "../common" }],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
