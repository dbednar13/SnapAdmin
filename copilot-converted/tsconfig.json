{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@constants/*": ["./src/constants/*"],
      "@types": ["./src/types/*"],
      "@utils/*": ["./src/utilities/*"]
    }
  },
  "include": ["src/**/*"]
}
